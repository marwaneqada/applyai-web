# Laravel API origin. The API client appends /api paths.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Reverb connection settings. Never expose REVERB_APP_SECRET here.
NEXT_PUBLIC_REVERB_APP_KEY=applyai-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
